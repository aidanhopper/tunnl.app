---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import '@/styles/globals.css';

import { Button } from '@/components/ui/button';
import TunnelActions from '@/components/TunnlActions.tsx';
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from "@/components/ui/card";
import Footer from '@/components/Footer.astro';
import Content from '@/components/Content.astro';
import serviceGeneralImage from '@/assets/service-general.png';
import serviceBindingsImage from '@/assets/service-bindings.png';
import linuxImage from '@/assets/linux.png';
import windowsImage from '@/assets/windows.png';
import macosImage from '@/assets/macos.png';
import dockerImage from '@/assets/docker.png';
import androidImage from '@/assets/android.png';
import iosImage from '@/assets/ios.png';
---

<Layout title="Tunnl.app — Easy service sharing">
    <main class='flex flex-col min-h-screen'>
        <Navbar animate={true}/>
        <Content>
            <div class='flex flex-col items-center mt-32 sm:mt-48'>
                <h1 class="text-5xl sm:text-7xl font-semibold text-center max-w-5xl slide1 px-2">
                    Share private services without a hassel.
                </h1>
                <p class='text-xl sm:text-2xl text-center max-w-4xl slide2 pt-16 px-4'>
                    <span class='bg-primary text-background font-bold italic'>Tunnl.app</span> 
                    is a fully self-hostable multi-tenant platform that allows you 
                    and your friends to share services across the Internet.
                </p>
                <div class='w-full pt-16'>
                    <div class='relative w-full container flex flex-col items-center md:pb-[170px] p-3 pt-8'>
                        <img 
                            class='shadow-2xl slide3 max-w-5xl w-full h-auto outline-4 
                            outline rounded-lg outline-neutral-700'
                            src={serviceGeneralImage.src}/>
                        <img 
                            class='static md:absolute right-10 bottom-0 mt-3
                            shadow-2xl slide3 max-w-2xl md:mt-8 outline-4 xl:block
                            outline outline-neutral-700 rounded-lg w-full h-auto'
                            src={serviceBindingsImage.src}/>
                    </div>
                </div>
                <div class='w-full pt-48 max-w-5xl flex flex-col items-center fade-in-section'>
                    <h1 class='text-2xl sm:text-5xl text-center font-semibold px-4'>
                        Self-hosting can be a
                        <span class='bg-primary text-background italic'>nightmare</span>
                        when you want to share across networks.
                    </h1>
                    <p class='mt-10 text-center max-w-4xl text-md sm:text-xl px-4'>
                        Ports. DNS. Firewalls. VPNs. ACLs. Way too much to think about when you or someone else 
                        needs access outside your home network.
                    </p>
                    <div class='grid gap-4 md:grid-cols-2 mt-12 w-full max-w-5xl px-4'>
                        <Card className='w-full'>
                            <CardHeader>
                                <CardTitle className='text-xl'>Managing service access with a VPN SaaS</CardTitle>
                                <CardDescription>Comparison with Tailscale.</CardDescription>
                            </CardHeader> 
                            <CardContent className='w-full space-y-6'>
                                <ul class='list-disc px-8 space-y-4'>
                                    <li>
                                        <strong>Self-hosting & source availability:</strong> Tailscale’s 
                                        client apps are open source, but the control plane (coordination server)
                                        is closed and not self-hostable. A community project, Headscale, 
                                        re-implements the coordination server API and lets you self-host,
                                        but it’s unofficial and not feature-parity with Tailscale’s SaaS.
                                    </li>
                                    <li>
                                        <strong>User/device limits:</strong>
                                        The free Personal plan allows 3 users and up to 100 devices. 
                                        Paid plans add pooled device quotas, billed per user.
                                    </li>
                                    <li>
                                        <strong>Granular access: </strong>
                                        You can share at the service/port level with ACLs and 
                                        features like Tailscale Serve, but you must configure 
                                        policies within their model, which can be complex.
                                    </li>
                                    <li>
                                        <strong>Multi-user self-hosting:</strong> 
                                        With Headscale, you can self-host a multi-user environment, 
                                        but it’s unofficial, lacks some enterprise features, and 
                                        requires manual setup of ACLs and coordination.
                                    </li>
                                    <li>
                                        <strong>Private DNS:</strong> 
                                        MagicDNS provides DNS inside the tailnet but cannot be fully customized.
                                    </li>
                                    <li>
                                        <strong>Blocked networks: </strong>
                                        Tailscale defaults to WireGuard/UDP but falls back to relays 
                                        (DERP) over TLS/TCP 443. It often works in restrictive networks,
                                        though admins can block relays.
                                    </li>
                                </ul>
                            </CardContent> 
                        </Card>
                        <Card className='w-full'>
                            <CardHeader>
                                <CardTitle className='text-xl'>Managing service access with Tunnl.app</CardTitle>
                                <CardDescription>
                                    How Tunnl.app handles this.
                                </CardDescription>
                            </CardHeader> 
                            <CardContent className='w-full space-y-6'>
                                <ul class='list-disc px-8 space-y-4'>
                                    <li>
                                        <strong>Self-hosting & source availability:</strong> 
                                        Fully self-hostable with Docker; you can run your own controller 
                                        and share services without relying on a hosted SaaS.
                                    </li>
                                    <li>
                                        <strong>User/device limits:</strong> 
                                        No artificial limits — unlimited users, devices, and services.
                                    </li>
                                    <li>
                                        <strong>Granular access:</strong> 
                                        Service-based by default — share a single service (like a website 
                                        or game server) with an invite link. No need to expose an entire 
                                        machine or configure complex ACLs.
                                    </li>
                                    <li>
                                        <strong>Multi-user hosting:</strong> 
                                        Designed for communities — self-host a multi-user environment 
                                        where each user can create and share services within the same network.
                                    </li>
                                    <li>
                                        <strong>Private DNS:</strong> 
                                        Every network gets its own fully customizable private DNS,
                                        so services can be reached with simple hostnames instead of raw IPs.
                                    </li>
                                    <li>
                                        <strong>Blocked networks:</strong> 
                                        Tunnels are always established over HTTPS (TCP 443), 
                                        appearing like standard web traffic, making blocking harder 
                                        in restrictive environments. And if your domain is 
                                        blocked on some network, it's easy to add
                                        another edge router with a unblocked domain or IP.
                                    </li> 
                                    <li>
                                        <strong>Service usage data:</strong>
                                        Track connections, and usage per service and per user 
                                        with built-in analytics.
                                    </li>
                                </ul>
                            </CardContent> 
                        </Card>
                    </div>
                </div>
                <div class='w-full pt-40 max-w-3xl flex flex-col fade-in-section'>
                    <TunnelActions client:load/>
                </div>
                <div>
                <div class='w-full pt-48 max-w-3xl flex flex-col fade-in-section px-4'>
                    <h1 class='text-3xl md:text-5xl font-bold text-center px-4'>
                        Edge clients are available on
                    </h1>
                    <div class='grid grid-cols-2 sm:grid-cols-3 w-full justify-center items-center gap-8 mt-10'>
                        <Card className='h-full duration-100 hover:translate-y-[-5px]'>
                            <CardHeader>
                                <CardTitle className='text-center'>Windows</CardTitle>
                            </CardHeader>
                            <CardContent className='flex justify-center items-center'>
                                <img class='w-24' src={windowsImage.src} />
                            </CardContent>
                        </Card> 
                        <Card className='h-full duration-100 hover:translate-y-[-5px]'>
                            <CardHeader>
                                <CardTitle className='text-center'>Linux</CardTitle>
                            </CardHeader>
                            <CardContent className='flex justify-center items-center'>
                                <img class='w-24' src={linuxImage.src} />
                            </CardContent>
                        </Card> 
                        <Card className='h-full duration-100 hover:translate-y-[-5px]'>
                            <CardHeader>
                                <CardTitle className='text-center'>Android</CardTitle>
                            </CardHeader>
                            <CardContent className='flex justify-center items-center'>
                                <img class='w-24' src={androidImage.src} />
                            </CardContent>
                        </Card> 
                        <Card className='h-full duration-100 hover:translate-y-[-5px]'>
                            <CardHeader>
                                <CardTitle className='text-center'>MacOS</CardTitle>
                            </CardHeader>
                            <CardContent className='flex justify-center items-center'>
                                <img class='w-32' src={macosImage.src} />
                            </CardContent>
                        </Card> 
                        <Card className='h-full duration-100 hover:translate-y-[-5px]'>
                            <CardHeader>
                                <CardTitle className='text-center'>iOS</CardTitle>
                            </CardHeader>
                            <CardContent className='flex justify-center items-center'>
                                <img class='w-24' src={iosImage.src} />
                            </CardContent>
                        </Card> 
                        <Card className='h-full duration-100 hover:translate-y-[-5px]'>
                            <CardHeader>
                                <CardTitle className='text-center'>Docker</CardTitle>
                            </CardHeader>
                            <CardContent className='flex justify-center items-center'>
                                <img class='w-32' src={dockerImage.src} />
                            </CardContent>
                        </Card> 
                    </div>
                </div>
                <div class='w-full pt-48 pb-10 max-w-3xl flex flex-col fade-in-section'>
                    <h1 class='text-3xl md:text-5xl font-bold text-center px-4'>Ready to give Tunnl.app a shot?</h1>
                    <p class='text-center mt-8 text-lg md:text-2xl px-4'>
                        Pick up a cheap VPS (I've been using Hetzner) 
                        and follow the Tunnl.app quickstart to get up and running in less than an hour!
                    </p>
                    <div class='flex w-full justify-center mt-8 px-4'>
                        <a href='/get-started' class='w-full'>
                            <Button className='text-2xl py-10 rounded-xl w-full'>
                                Start here <span class='text-4xl'>&rightarrow;</span>
                            </Button>
                        </a>
                    </div>
                </div>
            </div>
        </Content>
        <div class='justify-end pt-10'>
            <Footer />
        </div>
    </main>
</Layout>

<script>
  // This script runs on the client
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        // Optional: stop observing after animation triggers
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observe all fade-in sections
  document.querySelectorAll('.fade-in-section').forEach((section) => {
    observer.observe(section);
  });
</script>

<style>
@keyframes slidein {
  from {
    transform: translateY(30px);
    opacity: 0;
  }
  to {
    transform: translateY(0px);
    opacity: 100;
  }
}  

.fade-in-section {
    opacity: 0;
}

.fade-in-section.visible {
    animation: slidein 0.3s linear forwards;
    animation-delay: 0.2s;
    opacity: 0;
}

.slide1 {
    animation: slidein 0.4s linear forwards;
    animation-delay: 0.1s;
    opacity: 0;
}

.slide2 {
    animation: slidein 0.4s linear forwards;
    animation-delay: 0.1s;
    opacity: 0;
}

.slide3 {
    animation: slidein 0.4s linear forwards;
    animation-delay: 0.4s;
    opacity: 0;
}
</style>
